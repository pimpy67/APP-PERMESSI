# Copia questo file in .env e compila i valori.
# Non committare mai il file .env.

DATABASE_URL=postgres://utente_app:cambia-questa-password@localhost:5432/permessi
PORT=3000

# Impostalo a true solo in locale, per vedere la SQL injection in azione.
ESEMPI_VULNERABILI=false

# Chiave segreta per firmare i token JWT: almeno 32 caratteri casuali.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-questo-segreto
# Durata del token (formato della libreria jsonwebtoken: 30m, 1h, 8h, 1d, ...)
JWT_EXPIRES_IN=1h
